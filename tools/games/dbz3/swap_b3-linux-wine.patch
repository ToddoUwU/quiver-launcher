# Linux patch for the DBZ3 HD Mod Kit's 'mod center hd/swap_b3.py' (runs xbcompress.exe through Wine).
# Apply: cd '<Apps>/DragonBallZBudokai3HD-Budokai3HDRecompiled/mod center hd' && patch -p1 < this file
# 2026-11-14 fix: wineserver started as -p300 with stdio on /dev/null (was '-p 300' = forever, holding dbz3's
# popen pipe, so the launcher sat on 'Preparing' forever).
--- a/swap_b3.py
+++ b/swap_b3.py
@@ -82,11 +82,43 @@
     return env
 
 
+if os.name != 'nt':
+    # Linux: a dedicated, pre-initialised Wine prefix next to the game (no Mono/Gecko prompts),
+    # so each xbcompress call starts in well under a second instead of re-running wineboot.
+    os.environ.setdefault('WINEPREFIX', os.path.join(os.path.dirname(os.path.dirname(
+        os.path.abspath(__file__))), '.wine-kit'))
+    os.environ.setdefault('WINEDLLOVERRIDES', 'mscoree,mshtml=')
+    os.environ.setdefault('WINEDEBUG', '-all')
+    # Keep one wineserver alive for this prefix: a cold Wine start costs ~40 s, a warm call ~0.05 s,
+    # and the roster build makes one call per AFS entry it reads.
+    # "-p300" must be one word: "-p 300" means "persist forever". And the daemon must not inherit our
+    # stdout/stderr: dbz3 popen()s this script and waits for EOF, so a server holding the pipe left the
+    # launcher stuck on "Preparing" forever (2026-11-14).
+    try:
+        subprocess.run(['wineserver', '-p300'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                       stderr=subprocess.DEVNULL, timeout=30)
+    except Exception:
+        pass
+
+
+def _lzx_cmd(exe, *args):
+    """Linux: run the Windows xbcompress tools through Wine with Windows paths."""
+    if os.name == 'nt':
+        return [exe] + list(args)
+    def w(a):
+        if a.startswith('/') and ':' in a.split('/')[1][:3]:  # a switch like /N:2048
+            return a
+        if os.path.exists(a) or os.path.isdir(os.path.dirname(os.path.abspath(a))):
+            return 'Z:' + os.path.abspath(a).replace('/', '\\')  # Wine maps Z: to /
+        return a
+    return ['wine', exe] + [w(a) for a in args]
+
+
 def lzx_compress(src, dst, workdir=None):
     if os.path.exists(dst):
         os.remove(dst)
     env = _clean_env(workdir) if workdir else None
-    r = subprocess.run([XBCOMPRESS, '/N:2048', src, dst],
+    r = subprocess.run(_lzx_cmd(XBCOMPRESS, '/N:2048', src, dst),
                        capture_output=True, text=True, env=env)
     if r.returncode != 0:
         raise RuntimeError('xbcompress fallo: %s' % r.stdout + r.stderr)
@@ -97,7 +129,7 @@
     if os.path.exists(dst):
         os.remove(dst)
     env = _clean_env(workdir) if workdir else None
-    r = subprocess.run([XBDECOMPRESS, src, dst], capture_output=True, text=True,
+    r = subprocess.run(_lzx_cmd(XBDECOMPRESS, src, dst), capture_output=True, text=True,
                        env=env)
     if r.returncode != 0:
         raise RuntimeError('xbdecompress fallo: %s' % r.stdout + r.stderr)
