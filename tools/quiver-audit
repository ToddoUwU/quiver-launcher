#!/usr/bin/env python3
"""Read-only check that the real game library is healthy and that automatic updates are keeping up.

For every game: is its folder sound, can it start, and is it on the release quiverlauncher.com says it should be?
A game that stays behind for more than --grace-hours (default 24) while Quiver has been running counts as stuck.

Writes ~/.local/state/quiver/audit/latest.{json,md}. Exit 0 = nothing wrong, 1 = something needs a look.
--notify shows a desktop notification when something does. Nothing in the library is ever changed.
"""
import argparse, datetime as dt, json, os, re, subprocess, sys, urllib.parse, urllib.request

API = "https://api.quiverlauncher.com/api/v1"
HOME = os.path.expanduser("~")
LIB = os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "QuiverLauncher")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "quiver", "audit")


def fetch_status():
    """Every catalog app's verified release, keyed by lower-case repository."""
    status, cursor = {}, None
    for _ in range(50):
        url = API + "/release-status?limit=100" + (("&cursor=" + urllib.parse.quote(cursor)) if cursor else "")
        req = urllib.request.Request(url, headers={"User-Agent": "quiver-audit", "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=30) as r:
            page = json.load(r)
        for item in page.get("items", []):
            verified = item.get("verified") or {}
            if item.get("repository"):
                status.setdefault(item["repository"].lower(), []).append(
                    {"verified": verified.get("version"), "rolling": verified.get("rolling", False),
                     "latest": (item.get("latestUpstream") or {}).get("version"), "slug": item.get("slug")})
        cursor = page.get("nextCursor")
        if page.get("isDone") or not cursor:
            break
    return status


def same_version(a, b):
    def norm(v):
        return re.sub(r"^[^0-9]*", "", (v or "").strip()).lower() or (v or "").strip().lower()
    return (a or "").strip() == (b or "").strip() or norm(a) == norm(b)


def read(path):
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return None


def folder_of(app):
    return app.get("installPath") or os.path.join(LIB, "Apps", app.get("folderName") or "")


def check_app(app, status):
    folder = folder_of(app)
    r = {"name": app.get("name"), "repository": app.get("repository"), "folder": folder, "problems": [], "notes": []}
    if not os.path.isdir(folder):
        r["state"] = "not installed"
        return r
    r["installed"] = read(os.path.join(folder, "version.txt"))
    if os.path.exists(os.path.join(folder, "install-incomplete.txt")):
        r["problems"].append("an install was interrupted (install-incomplete.txt)")
    selected = read(os.path.join(folder, "selected_executable.txt"))
    if selected:
        path = selected if os.path.isabs(selected) else os.path.join(folder, selected)
        if not os.path.exists(path):
            r["problems"].append(f"the chosen program is missing: {selected}")
        elif not os.access(path, os.X_OK) and not path.lower().endswith(".exe"):
            r["problems"].append(f"the chosen program isn't executable: {selected}")
    try:
        for entry in os.scandir(folder):
            if entry.is_symlink() and not os.path.exists(entry.path):
                r["problems"].append(f"broken link: {entry.name} -> {os.readlink(entry.path)}")
    except OSError as e:
        r["problems"].append(f"can't read the folder: {e}")

    pin = app.get("preferredVersion")
    if pin:
        r["state"] = "pinned"
        r["notes"].append(f"pinned to {pin}")
        if r.get("installed") and not same_version(r["installed"], pin):
            r["problems"].append(f"pinned to {pin} but {r['installed']} is installed")
        return r
    listed = status.get((app.get("repository") or "").lower()) if status is not None else None
    if status is None:
        r["state"] = "catalog unreachable"
    elif not listed:
        r["state"] = "not in catalog"
    else:
        verified = [x["verified"] for x in listed if x["verified"]]
        r["verified"] = verified[0] if verified else None
        if not verified:
            r["state"] = "no verified release"
        elif any(x["rolling"] and same_version(r.get("installed"), x["verified"]) for x in listed):
            r["state"] = "rolling"
        elif not r.get("installed"):
            r["state"] = "unknown version"
            r["problems"].append("no version.txt")
        elif any(same_version(r["installed"], v) for v in verified):
            r["state"] = "up to date"
        elif app.get("skippedUpdateVersion") and any(same_version(app["skippedUpdateVersion"], v) for v in verified):
            r["state"] = "skipped by you"
        elif not app.get("autoUpdate"):
            r["state"] = "update available (automatic updates off)"
        else:
            r["state"] = "behind"
    return r


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--notify", action="store_true")
    ap.add_argument("--grace-hours", type=float, default=24)
    ap.add_argument("--library", default=None)
    a = ap.parse_args()
    data = json.load(open(a.library or os.path.join(LIB, "apps.json"), encoding="utf-8-sig"))
    apps = data if isinstance(data, list) else data.get("apps", [])
    try:
        status = fetch_status()
    except Exception as e:  # noqa: BLE001 - offline is a result, not a crash
        print(f"quiver-audit: catalog unreachable: {e}", file=sys.stderr)
        status = None
    os.makedirs(STATE, exist_ok=True)
    seen_path = os.path.join(STATE, "behind-since.json")
    try:
        seen = json.load(open(seen_path))
    except (OSError, ValueError):
        seen = {}
    now = dt.datetime.now(dt.timezone.utc)
    rows = [check_app(x, status) for x in apps]
    still = {}
    for r in rows:
        key = r.get("repository") or r.get("name")
        if r.get("state") == "behind":
            first = dt.datetime.fromisoformat(seen.get(key, now.isoformat()))
            still[key] = first.isoformat()
            hours = (now - first).total_seconds() / 3600
            r["behind_hours"] = round(hours, 1)
            if hours > a.grace_hours:
                r["problems"].append(f"still on {r.get('installed')} {hours:.0f} hours after {r.get('verified')} was verified")
    json.dump(still, open(seen_path, "w"), indent=1)

    counts = {}
    for r in rows:
        counts[r.get("state", "?")] = counts.get(r.get("state", "?"), 0) + 1
    problems = [r for r in rows if r["problems"]]
    report = {"when": now.isoformat(), "games": len(rows), "counts": counts, "problems": len(problems), "rows": rows}
    json.dump(report, open(os.path.join(STATE, "latest.json"), "w"), indent=1)
    with open(os.path.join(STATE, "latest.md"), "w") as f:
        f.write(f"# Library audit, {now:%Y-%m-%d %H:%M} UTC\n\n{len(rows)} games: " + ", ".join(f"{v} {k}" for k, v in sorted(counts.items())) + "\n\n")
        for r in problems:
            f.write(f"- **{r['name']}**: " + "; ".join(r["problems"]) + "\n")
        behind = [r for r in rows if r.get("state") == "behind"]
        if behind:
            f.write("\n## Behind\n\n")
            for r in behind:
                f.write(f"- {r['name']}: {r.get('installed')} installed, {r.get('verified')} verified ({r.get('behind_hours')} h)\n")
    print(f"{len(rows)} games: " + ", ".join(f"{v} {k}" for k, v in sorted(counts.items())))
    for r in rows:
        if r.get("state") == "behind":
            print(f"  behind: {r['name']}: {r.get('installed')} -> {r.get('verified')}")
    for r in problems:
        print(f"  PROBLEM {r['name']}: " + "; ".join(r["problems"]))
    if problems and a.notify:
        text = "; ".join(r["name"] for r in problems[:6]) + (" and more" if len(problems) > 6 else "")
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path", "/org/freedesktop/Notifications",
                        "--method", "org.freedesktop.Notifications.Notify", "Quiver Launcher", "0", "quiver-launcher", "Quiver library audit",
                        f"{len(problems)} game(s) need a look: {text}. See {STATE}/latest.md", "[]", "{}", "20000"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
