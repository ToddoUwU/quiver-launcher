#!/usr/bin/env python3
"""Measures a Quiver build the same way each time, in a hidden display, so real monitors are never involved.

  quiver-bench [--runs 5] [--settle 45] [--label name] [--json out.json] -- /path/to/QuiverLauncher.Desktop

For each run: time until the window exists, until something is drawn and until the picture stops changing; then memory,
and CPU, wakeups and threads while it sits idle. Prints medians. Reads the real library; changes nothing in it.
"""
import argparse, json, os, re, signal, statistics, subprocess, sys, tempfile, time

TICK = os.sysconf("SC_CLK_TCK")


def run(*cmd, **kw):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, **kw).stdout


def descendants(root):
    seen, todo = set(), [root]
    while todo:
        pid = todo.pop()
        if pid not in seen:
            seen.add(pid)
            todo += [int(x) for x in run("pgrep", "-P", str(pid)).split()]
    return seen


def find_app(root, name):
    for pid in descendants(root):
        try:
            if os.path.basename(os.readlink(f"/proc/{pid}/exe")) in (name, "dotnet"):
                return pid
        except OSError:
            pass
    return None


def thread_stats(pid):
    """CPU ticks of the whole process (finished threads included), and context switches of the threads still running."""
    ticks = switches = threads = 0
    try:
        fields = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
        ticks = int(fields[11]) + int(fields[12])
        for tid in os.listdir(f"/proc/{pid}/task"):
            try:
                status = open(f"/proc/{pid}/task/{tid}/status").read()
                switches += sum(int(x) for x in re.findall(r"ctxt_switches:\s+(\d+)", status))
                threads += 1
            except (OSError, IndexError):
                pass
    except OSError:
        pass
    return ticks, switches, threads


def rss_mb(pid):
    try:
        for line in open(f"/proc/{pid}/status"):
            if line.startswith("VmRSS"):
                return int(line.split()[1]) / 1024
    except OSError:
        pass
    return 0


def grab(display, window):
    return subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "x11grab", "-window_id", window, "-i", display, "-frames:v", "1",
                           "-vf", "scale=96:54,format=gray", "-f", "rawvideo", "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout


def one_run(cmd, settle, env_extra):
    display_file = tempfile.NamedTemporaryFile(prefix="bench-display-", delete=False).name
    env = dict(os.environ, BENCH_DISPLAY=display_file, QuiverLauncher_SKIP_UPDATES="1", **env_extra)
    env.pop("WAYLAND_DISPLAY", None)
    inner = 'echo "$DISPLAY" > "$BENCH_DISPLAY"; exec "$@"'
    data = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "QuiverLauncher")
    start = time.time()
    proc = subprocess.Popen(["gamescope", "--backend", "headless", "-W", "2560", "-H", "1440", "-w", "2560", "-h", "1440", "--", "bash", "-c", inner, "bench"] + cmd,
                            cwd=data, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    display = None
    while time.time() - start < 20 and not display:
        time.sleep(0.02)
        try:
            display = open(display_file).read().strip()
        except OSError:
            pass
    launched = time.time()
    window, t_window, t_drawn, t_stable, last, last_change, app = None, None, None, None, None, None, None
    name = os.path.basename(cmd[0])
    while time.time() - launched < 60:
        if window is None:
            found = re.findall(r'^\s+(0x[0-9a-f]+) "(?!steamcompmgr)[^"]+":', run("xwininfo", "-display", display, "-root", "-tree"), re.M)
            if found:
                window, t_window = found[0], time.time() - launched
            else:
                time.sleep(0.03)
            continue
        frame = grab(display, window)
        if frame:
            if t_drawn is None and sum(frame) / len(frame) > 2:
                t_drawn = time.time() - launched
            if frame != last:
                last, last_change = frame, time.time() - launched
            # A picture unchanged for 3 seconds counts as finished.
            if t_drawn is not None and time.time() - launched - last_change > 3:
                t_stable = last_change
                break
        time.sleep(0.05)
    app = find_app(proc.pid, name)
    result = {"window_s": t_window, "drawn_s": t_drawn, "settled_s": t_stable}
    if app and settle > 0:
        # Let startup work finish, then measure truly idle behaviour.
        time.sleep(settle)
        ticks0, sw0, threads = thread_stats(app)
        t0 = time.time()
        time.sleep(20)
        ticks1, sw1, threads = thread_stats(app)
        secs = time.time() - t0
        result.update(rss_mb=round(rss_mb(app)), threads=threads, idle_cpu_pct=round(100 * (ticks1 - ticks0) / TICK / secs, 2), wakeups_per_s=round((sw1 - sw0) / secs, 1),
                      startup_cpu_s=round(ticks0 / TICK, 2))
    elif app:
        result.update(rss_mb=round(rss_mb(app)), startup_cpu_s=round(thread_stats(app)[0] / TICK, 2))
    for pid in descendants(proc.pid) - {proc.pid}:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(1)
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass
    proc.wait(timeout=10)
    os.unlink(display_file)
    return result


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--runs", type=int, default=5)
    ap.add_argument("--settle", type=float, default=30)
    ap.add_argument("--label", default="")
    ap.add_argument("--json")
    ap.add_argument("--env", action="append", default=[])
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    a = ap.parse_args()
    cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
    env_extra = dict(kv.split("=", 1) for kv in a.env)
    runs = []
    for i in range(a.runs):
        r = one_run(cmd, a.settle if i == a.runs - 1 else 0, env_extra)
        runs.append(r)
        print(f"run {i + 1}: {r}", file=sys.stderr)
    summary = {"label": a.label, "runs": a.runs}
    for key in ("window_s", "drawn_s", "settled_s", "rss_mb", "threads", "idle_cpu_pct", "wakeups_per_s", "startup_cpu_s"):
        values = [r[key] for r in runs if r.get(key) is not None]
        if values:
            summary[key] = round(statistics.median(values), 3)
    print(json.dumps(summary))
    if a.json:
        json.dump({"summary": summary, "runs": runs}, open(a.json, "w"), indent=1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
